# --- App ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# --- CORS (comma-separated origins if overriding via real env, JSON array if in .env file loader) ---
CORS_ORIGINS=["http://localhost:5173","app://."]

# --- Supabase (from Project Settings -> API) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Database (Project Settings -> Database -> Connection string, use the pooler for serverless) ---
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# --- AI Provider ---
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-1.5-flash

# --- Scheduler ---
SCRAPE_INTERVAL_HOURS=6
RUN_SCHEDULER_IN_PROCESS=true
MATCH_MIN_SCORE=0.55

# --- Scraper config ---
GREENHOUSE_BOARD_TOKENS=stripe,figma,notion

# --- Notifications ---
NOTIFICATIONS_ENABLED=true
